<?xml version="1.0" encoding="utf-8"?>
<!--
  Where signed-in sessions are kept, so that a restart does not sign the farm out.

  These two tables and their column names are Spring Session's, not this application's - its SQL is
  written against them literally, so a rename here is a runtime failure rather than a compile one.
  The *types* are Liquibase's logical ones rather than the shipped DDL's, which is what keeps the
  schema portable: ATTRIBUTE_BYTES is `blob`, which resolves to LONGVARBINARY on H2 and BYTEA on
  PostgreSQL, so this fragment does not have to be rewritten the day the database moves.

  It is infrastructure rather than a module's data, the way the event publication registry is, and
  it lives beside the people roster because that is the module that knows what a signed-in user is.
-->
<databaseChangeLog
        logicalFilePath="db/changelog/sessions.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="sessions-1" author="p3d">
        <createTable tableName="SPRING_SESSION">
            <column name="PRIMARY_ID" type="char(36)">
                <constraints primaryKey="true" primaryKeyName="SPRING_SESSION_PK" nullable="false"/>
            </column>
            <column name="SESSION_ID" type="char(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CREATION_TIME" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_ACCESS_TIME" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="MAX_INACTIVE_INTERVAL" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="EXPIRY_TIME" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="PRINCIPAL_NAME" type="varchar(100)"/>
        </createTable>

        <!--
          IX2 is the one the sweeper uses, and the reason it exists: expiring sessions is a range
          scan over EXPIRY_TIME that would otherwise read the whole table every minute.
        -->
        <createIndex tableName="SPRING_SESSION" indexName="SPRING_SESSION_IX1" unique="true">
            <column name="SESSION_ID"/>
        </createIndex>
        <createIndex tableName="SPRING_SESSION" indexName="SPRING_SESSION_IX2">
            <column name="EXPIRY_TIME"/>
        </createIndex>
        <createIndex tableName="SPRING_SESSION" indexName="SPRING_SESSION_IX3">
            <column name="PRINCIPAL_NAME"/>
        </createIndex>
    </changeSet>

    <changeSet id="sessions-2" author="p3d">
        <createTable tableName="SPRING_SESSION_ATTRIBUTES">
            <column name="SESSION_PRIMARY_ID" type="char(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ATTRIBUTE_NAME" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="ATTRIBUTE_BYTES" type="blob">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="SPRING_SESSION_ATTRIBUTES"
                       columnNames="SESSION_PRIMARY_ID, ATTRIBUTE_NAME"
                       constraintName="SPRING_SESSION_ATTRIBUTES_PK"/>
        <!--
          ON DELETE CASCADE is not decoration: deleting a session is one DELETE against
          SPRING_SESSION, and without the cascade every signed-out user leaves their attributes
          behind forever.
        -->
        <addForeignKeyConstraint baseTableName="SPRING_SESSION_ATTRIBUTES"
                                 baseColumnNames="SESSION_PRIMARY_ID"
                                 constraintName="SPRING_SESSION_ATTRIBUTES_FK"
                                 referencedTableName="SPRING_SESSION"
                                 referencedColumnNames="PRIMARY_ID"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
